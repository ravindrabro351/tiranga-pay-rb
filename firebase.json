{
  "database": {"rules": "database.rules.json"},
  "hosting": [
    {
      "target": "user",
      "public": "user-app",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{"source": "**", "destination": "/index.html"}],
      "headers": [{"source": "**/*.@(js|css)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}]
    },
    {
      "target": "admin",
      "public": "admin-app",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "rewrites": [{"source": "**", "destination": "/index.html"}],
      "headers": [{"source": "**/*.@(js|css)", "headers": [{"key": "Cache-Control", "value": "no-cache"}]}]
    }
  ]
}
